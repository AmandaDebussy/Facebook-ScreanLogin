# Ignora a pasta node_modules que contém as dependências do projeto
node_modules/

# Ignora arquivos de build gerados por Tailwind
/dist
/build

# Ignora arquivos de cache do npm/yarn
.npm/
.yarn/
.yarn-integrity

# Ignora arquivos de logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignora arquivos de configuração do IDE
.idea/
.vscode/

# Ignora a pasta de cache do Tailwind (caso você tenha configurado algo como isso)
.tailwind/

# Ignora arquivos gerados pelo sistema operacional (exemplo: .DS_Store no macOS)
.DS_Store
Thumbs.db
